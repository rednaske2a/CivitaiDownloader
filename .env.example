# Server Configuration
PORT=5000
NODE_ENV=development

# CivitAI Configuration (Optional - can be set via web UI Settings page)
# Get your API key from: https://civitai.com/user/account
# CIVITAI_API_KEY=your_api_key_here

# ComfyUI Configuration (Optional - can be set via web UI Settings page)
# Path to your ComfyUI installation directory
# Leave empty to simulate downloads without actual file operations
# Windows example: C:/ComfyUI
# Linux/Mac example: /home/username/ComfyUI
# COMFYUI_PATH=
